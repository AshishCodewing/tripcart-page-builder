# Postgres connection string. pgvector extension must be available on this DB.
DATABASE_URL=

# Google AI Studio key — used for text-embedding-004 at ingest + retrieval.
# Get one at https://aistudio.google.com/apikey. Free tier is ~1500 req/day.
GOOGLE_API_KEY=

# Anthropic key — used by downstream consumers of retrieveDocs() that want a
# Claude-backed answer. Not required by the ingest script itself.
ANTHROPIC_API_KEY=

# Optional. Raises GitHub API rate limits for `pnpm ingest:grapesjs-source`
# (read by lib/rag/github.ts and scripts/ingest-grapesjs-source.ts).
GITHUB_TOKEN=

# OpenRouter key — powers the AI assistant chat route (app/api/chat/route.ts).
# Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Langfuse LLM observability. Traces from the AI assistant are exported here via
# OpenTelemetry (see instrumentation.node.ts + lib/ai/tracing.ts). Keys are in
# Langfuse → Settings → API Keys. BASE_URL is the region host:
# EU https://cloud.langfuse.com · US https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Billing gate behavior when the credit balance check itself errors.
# Unset/0 = fail open (AI keeps working, cost risk bounded by the charge
# clamp). 1 = fail closed (requests 402 until the ledger is reachable).
BILLING_GATE_FAIL_CLOSED=

# Vercel deploy only — not needed locally. scripts/migrate-on-deploy.mjs runs
# `prisma migrate deploy` over this DIRECT (unpooled) Neon connection during
# production builds; the app's runtime keeps using the pooled DATABASE_URL.
DATABASE_URL_UNPOOLED=
