{
  "name": "tripcart-page-builder",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-vendor-css.mjs",
    "prebuild": "node scripts/sync-vendor-css.mjs && node scripts/migrate-on-deploy.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "node scripts/drizzle-baseline.mjs",
    "postinstall": "node scripts/sync-vendor-css.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ingest:grapesjs": "tsx scripts/ingest-grapesjs-docs.ts",
    "ingest:grapesjs-react": "tsx scripts/ingest-grapesjs-react-docs.ts",
    "ingest:grapesjs-source": "tsx scripts/ingest-grapesjs-source.ts",
    "ingest:grapesjs-symbols": "tsx scripts/ingest-grapesjs-symbols.ts",
    "ingest:wp-themes": "tsx scripts/ingest-wp-themes-docs.ts",
    "ingest:prosemirror": "tsx scripts/ingest-prosemirror-docs.ts",
    "audit:chrome": "tsx scripts/audit-page-chrome.ts",
    "mcp:rag": "tsx scripts/mcp-rag-server.ts",
    "mcp:prosemirror": "tsx scripts/mcp-prosemirror-server.ts",
    "smoke:ledger": "tsx scripts/smoke-ledger.ts",
    "backfill:css": "tsx scripts/backfill-css-artifacts.ts",
    "backfill:block-gap": "tsx scripts/backfill-block-gap.ts",
    "seed:credits": "tsx scripts/backfill-credit-seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.7",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@grapesjs/react": "^2.0.0",
    "@grapesjs/studio-sdk-plugins": "^1.0.38",
    "@langfuse/client": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@shadcn/react": "^0.1.0",
    "@tanstack/ai": "^0.38.0",
    "@tanstack/ai-client": "^0.19.0",
    "@tanstack/ai-openrouter": "^0.15.5",
    "@tanstack/ai-react": "^0.16.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colord": "^2.9.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "grapesjs": "^0.22.16",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-parser-postcss": "^1.0.3",
    "grapesjs-style-bg": "^2.0.2",
    "grapesjs-style-filter": "^1.0.2",
    "lucide-react": "^1.11.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "open-props": "^1.7.23",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.4",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@langchain/core": "^1.1.42",
    "@langchain/google-genai": "^2.1.29",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "fallow": "^2.86.0",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "^29.1.1",
    "p-queue": "^9.2.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
