// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum TemplateKind {
  // Page-shaped starting point — the "layout" in Next.js terms.
  // Includes a content slot and typically references one or more PART
  // templates (header, footer). Used to scaffold a new Page.
  LAYOUT
  // Section-scope starting point — a block of content (hero, pricing
  // table, etc.). Surfaced in the in-canvas inserter alongside
  // code-defined Block primitives.
  PATTERN
  // Area-tagged reusable chrome (header, footer, sidebar, …). Always
  // synced by intent. `area` is required when kind = PART.
  PART
}

enum LedgerAccountType {
  SYSTEM // platform-owned, tenantId = null
  TENANT // one TENANT_WALLET per tenant
}

model Tenant {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  domain            String?            @unique
  // Tenant-wide brand theme — full Theme document as defined in
  // lib/theme/schema.ts. Empty `{}` means "use the bundled defaultTheme."
  theme             Json               @default("{}")
  // Monotonic counter bumped on every theme write. Embedded in the
  // compiled-theme CSS URL so each version is its own cache key, served
  // immutable — theme edits invalidate by URL change, not by purge.
  themeVersion      Int                @default(1)
  // Compiled theme CSS baked at updateTenantTheme so a read-only renderer
  // can serve a string without importing compileTheme. null = no theme
  // write since the artifact pipeline landed (run `pnpm backfill:css`).
  themeCss          String?
  // cssContentKey(themeCss) — pure URL cache-buster, never a lookup key.
  themeCssHash      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pages             Page[]
  posts             Post[]
  templates         Template[]
  chromeAssignments ChromeAssignment[]

  @@map("tenants")
}

// Per-route-segment site chrome assignment (WP custom-template style): which
// header/footer template part renders on each preview route segment. The
// site-owns-the-frame model still holds — this just lets the frame differ by
// segment (e.g. a different header for `pages/` vs `posts/`).
//
// `headerSlug` / `footerSlug` store slugs (not FK ids) so they inherit the
// tenant-first / global-fallback shadowing `resolveChromeBySlug` does — the
// WP way of referencing template parts by slug. null = inherit the tenant
// default chrome slug ("header" / "footer"), which itself falls back to the
// code-default part. So an unassigned segment renders exactly as before
// Piece 2 (non-breaking). One row per (tenant, segment); `segment` is a
// TEMPLATE_HIERARCHY slug (lib/cms/template-hierarchy.ts) — `page`, `single`,
// `archive`, …, with `index` as the catch-all — app-owned, not a DB enum.
model ChromeAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segment    String
  headerSlug String?
  footerSlug String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, segment])
  @@map("chrome_assignments")
}

model Page {
  id          String        @id @default(cuid())
  slug        String
  path        String
  parentId    String?
  parent      Page?         @relation("PageTree", fields: [parentId], references: [id])
  children    Page[]        @relation("PageTree")
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  data        Json          @default("{}")
  // In-progress editor autosave (full ProjectDefinition). null = no
  // draft ahead of `data`; the editor seeds from `draftData ?? data` and
  // the public render reads `data` only. Cleared on explicit Save/Publish.
  draftData   Json?
  // Compiled page-scoped CSS artifact (this page's own rules only —
  // template-ref styles stay on their Template rows; protected theme rules
  // stripped). Written in lockstep with `data`; "" is a real empty
  // artifact, null = row predates the pipeline (run `pnpm backfill:css`).
  css         String?
  // cssContentKey(css) — pure cache-buster for /api/css URLs.
  cssHash     String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Path uniqueness is scoped per tenant — two tenants can each own
  // `/about` independently. Sibling uniqueness keeps slugs unique
  // within a parent's children regardless of tenant (which is fine
  // because parentId values don't overlap across tenants).
  @@unique([tenantId, path])
  @@unique([parentId, slug])
  @@index([status])
  @@index([tenantId])
  @@map("pages")
}

model Post {
  id            String        @id @default(cuid())
  slug          String
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  excerpt       String?
  // URL of the post's featured image. Bound into a single-post LAYOUT's
  // `post-featured-image` field block at render (see lib/cms/post-template.ts);
  // null = the field is omitted from the rendered template.
  featuredImage String?
  data          Json          @default("{}")
  // In-progress editor autosave (full ProjectDefinition). See Page.draftData.
  draftData     Json?
  // Compiled post-scoped CSS artifact. See Page.css.
  css           String?
  cssHash       String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  categories    Category[]    @relation("PostCategories")
  tags          Tag[]         @relation("PostTags")

  // Slug uniqueness is scoped per tenant — two tenants can each own
  // `/blog/hello-world` independently.
  @@unique([tenantId, slug])
  @@index([status, publishedAt])
  @@index([tenantId])
  @@map("posts")
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[] @relation("PostCategories")

  @@map("categories")
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[] @relation("PostTags")

  @@map("tags")
}

// Reusable content units referenced from Page/Post project data.
//
// One table covers three UX roles (see `kind`) plus the global-vs-tenant
// library split (see `tenantId` nullability). See docs/reference/templates.md for
// the design walkthrough.
//
// Slug uniqueness is enforced by two indexes, since Prisma 7's `@@unique`
// can't express partial conditions:
//   - `@@unique([tenantId, slug])` (below) — for tenant rows, the
//     standard composite. NULL tenantIds are treated as distinct by
//     default Postgres semantics, so this does NOT prevent duplicate
//     globals.
//   - A partial unique index `(slug) WHERE tenantId IS NULL`, added in
//     the migration SQL — guarantees one row per slug among globals.
// Within a tenant, a row with the same slug as a global shadows it at
// render — the renderer prefers the tenant row over the global fallback.
model Template {
  id          String       @id @default(cuid())
  // null = global library; non-null = tenant-scoped (can shadow global)
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  kind        TemplateKind
  // Only set when kind = PART, e.g. "header" | "footer" | "sidebar".
  // Not enforced in the DB; the app layer should validate.
  area        String?
  // true = insert as `template-ref` (resolved at render, edits propagate)
  // false = copy the `data` subtree into the consuming Page on insert
  // The flag affects FUTURE inserts only; existing refs/copies are
  // unchanged when this toggles.
  synced      Boolean      @default(false)
  title       String
  description String?
  // GrapesJS subtree (styles + components) — same shape as a slice of
  // `Page.data.pages[].frames[].component`.
  data        Json         @default("{}")
  // In-progress editor autosave, stored in the slim `{ component, styles }`
  // shape (same as `data`). null = no draft ahead of `data`. See Page.draftData.
  draftData   Json?
  // Compiled part-scoped CSS artifact — deliberately separate from any
  // consuming Page's artifact: a renderer resolves template-refs, then
  // composes page CSS + each part's CSS. See Page.css.
  css         String?
  cssHash     String?
  // Optional thumbnail URL for inserter UIs.
  preview     String?
  // No publish lifecycle: a template reaches the public site only by
  // being inserted into a Page/Post, whose own status gates publication.
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, kind])
  @@map("templates")
}

// Stub for post-MVP slug-rename redirects. Unused at MVP.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())

  @@map("redirects")
}

model DocChunk {
  id          String                      @id @default(cuid())
  contentHash String                      @unique
  content     String
  headerPath  String
  kind        String
  tokenCount  Int
  embedding   Unsupported("vector(3072)")
  createdAt   DateTime                    @default(now())

  urls DocChunkUrl[]

  @@map("doc_chunks")
}

model DocChunkUrl {
  id         String   @id @default(cuid())
  chunkHash  String
  url        String
  title      String
  lastSeenAt DateTime @default(now())

  chunk DocChunk @relation(fields: [chunkHash], references: [contentHash], onDelete: Cascade)

  @@unique([chunkHash, url])
  @@index([url])
  @@map("doc_chunk_urls")
}

model LedgerAccount {
  id          String            @id @default(uuid())
  tenantId    String? // null = system account
  accountCode String
  accountType LedgerAccountType
  createdAt   DateTime          @default(now())

  entries LedgerEntry[]
  balance AccountBalance?

  // Per-tenant uniqueness. Global (tenantId NULL) dedupe is a PARTIAL unique
  // index added in the migration SQL — see below. Same trick as Template.
  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id              String   @id @default(uuid())
  tenantId        String?
  transactionType String
  referenceType   String?
  referenceId     String?
  description     String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  entries LedgerEntry[]

  @@index([tenantId])
  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  amount        BigInt // signed units; + increease, - decreases
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model AccountBalance {
  accountId String        @id
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  balance   BigInt        @default(0)
  updatedAt DateTime      @updatedAt

  @@map("account_balances")
}
